<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>seb_online</name>
  <version>0.1.0</version>
  <description>
    Online (ROS 2) state-estimation benchmark for the Unitree Go2: LowState acquisition,
    concurrent Pinocchio foot kinematics and foot-force contact detection, exact sample-id
    synchronisation, and one selected estimator (MUSE, IEKF or invariant smoother).
    Monitoring only: no actuation interface.
  </description>
  <maintainer email="ylenia.nistico@iit.it">Ylenia Nisticò</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>lifecycle_msgs</depend>
  <depend>std_srvs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>seb_interfaces</depend>
  <depend>unitree_go</depend>
  <depend>dls2_interface</depend>
  <depend>eigen</depend>
  <depend>pinocchio</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-psutil</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
